---
import MainLayout from '../layouts/MainLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import homeData from '../content/pages/home.json';
---

<MainLayout title={homeData.description} description={homeData.description}>
	<Nav lang="en" />
	
	<div style="position: fixed; inset: 0; background-color: #1A1A1A; background-image: radial-gradient(ellipse at 50% 50%, rgba(123, 79, 166, 0.45) 0%, transparent 80%); z-index: -1;"></div>
	<main style="color: white; position: relative;">
		<section class="hero" style="position: relative;">
			<div class="container hero-inner" style="position: relative; z-index: 1;">
				<div class="hero-content">
					<span class="hero-tag">✦ Breathing Training App</span>
					<h1 set:html={homeData.heroTitle.replace(',', ',<br>')}></h1>
					<p>{homeData.heroSubtitle}</p>
					<div class="hero-actions">
						<a href={homeData.appStoreLink} class="btn-download-white">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
							Download on App Store
						</a>
					</div>
					<p class="hero-note">Free to download · iOS 18.6+ only</p>
				</div>
				<div class="hero-image">
					{homeData.heroImages.map((src, i) => (
						<img src={src} alt="Toona App Preview" width="210" height="455">
					))}
				</div>
			</div>
		</section>

		<!-- Features -->
		<section class="features section">
			<div class="container" style="position: relative; z-index: 1;">
				<div class="section-header">
					<h2>{homeData.features.title}</h2>
					<p>{homeData.features.subtitle}</p>
				</div>
				<div class="features-grid">
					{homeData.features.items.map(feature => (
						<div class="card feature-card">
							<div class="icon-circle" style={`background:${feature.color};`}>{feature.icon}</div>
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Showcase: Stats -->
		<section class="showcase section dark" style="position: relative; overflow: hidden;">
			<div class="container showcase-inner" style="position: relative; z-index: 1;">
				<div class="showcase-screens">
					{homeData.showcase.images.map(src => (
						<img src={src} alt="Toona Showcase" width="175" height="380">
					))}
				</div>
				<div class="showcase-content">
					<span class="hero-tag">{homeData.showcase.tag}</span>
					<h2>{homeData.showcase.title}</h2>
					<p>{homeData.showcase.description}</p>
				</div>
			</div>
		</section>

		<!-- Download CTA -->
		<section class="download-cta">
			<div class="container" style="position: relative; z-index: 1;">
				<h2>{homeData.cta.title}</h2>
				<p>{homeData.cta.description}</p>
				<a href={homeData.appStoreLink} class="btn-cta-pill">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					Download on App Store
				</a>
			</div>
		</section>

	</main>

	<Footer lang="en" />
</MainLayout>


<style>
	.container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.hero {
		background: transparent;
		color: white;
		padding: 8rem 0 4rem;
		min-height: 80vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.hero-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}
	.hero-tag {
		display: inline-block;
		background: rgba(123, 79, 166, 0.2);
		color: #4ECDC4;
		border: 1px solid rgba(78, 205, 196, 0.2);
		padding: 0.25rem 0.75rem;
		border-radius: 99px;
		font-size: 0.875rem;
		margin-bottom: 1rem;
	}
	.hero h1 {
		font-size: 4rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}
	.hero p {
		font-size: 1.25rem;
		color: #9CA3AF;
		margin-bottom: 2.5rem;
		max-width: 480px;
	}
	.hero-actions { display: flex; gap: 1rem; }
	
	.btn {
		padding: 0.75rem 2rem;
		border-radius: 99px;
		font-weight: 600;
		transition: transform 0.2s;
	}
	.btn:hover { transform: translateY(-2px); }
	.btn-primary { background: #7B4FA6; color: white; }
	.btn-outline { border: 2px solid rgba(255,255,255,0.2); color: white; }
	
	.btn-download-white { 
		display: inline-flex; 
		align-items: center; 
		background: white; 
		color: #7B4FA6; 
		padding: 0.8rem 2rem; 
		border-radius: 99px; 
		font-weight: 700; 
		text-decoration: none;
		box-shadow: 0 4px 15px rgba(0,0,0,0.1);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.btn-download-white:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(255,255,255,0.2);
	}
	.btn-cta-pill {
		display: inline-flex;
		align-items: center;
		background: white;
		color: #7B4FA6;
		padding: 1rem 2.5rem;
		border-radius: 99px;
		font-weight: 800;
		font-size: 1.1rem;
		text-decoration: none;
		box-shadow: 0 10px 30px rgba(0,0,0,0.2);
		transition: all 0.3s ease;
	}
	.btn-cta-pill:hover {
		transform: scale(1.05);
		box-shadow: 0 15px 40px rgba(255,255,255,0.25);
	}
	.hero-note { font-size: 0.75rem; color: #6B7280; margin-top: 1rem; }

	.features { position: relative; background: transparent; }
	.section { padding: 5rem 0; }
	.section-header { text-align: center; margin-bottom: 3rem; }
	.section-header h2 { font-size: 2.5rem; margin-bottom: 1rem; color: white; }
	.section-header p { color: #9CA3AF; font-size: 1.125rem; }
	
	.features-grid { 
		display: grid; 
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
		gap: 2rem; 
	}
	.card { 
		background: rgba(255, 255, 255, 0.04); 
		padding: 2rem; 
		border-radius: 1.5rem; 
		border: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(16px);
		transition: background 0.3s ease, transform 0.3s ease;
	}
	.card:hover { background: rgba(255, 255, 255, 0.08); transform: translateY(-3px); }
	.icon-circle {
		width: 48px; height: 48px;
		border-radius: 50%;
		display: flex; align-items: center; justify-content: center;
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.feature-card h3 { color: white; margin-bottom: 1rem; }
	.feature-card p { font-size: 0.875rem; color: #9CA3AF; line-height: 1.6; }

	/* Showcase Sections */
	.showcase.dark { color: white; background: transparent; }
	.showcase.dark .hero-tag { background: rgba(123,79,166,0.2); color: #4ECDC4; }
	.showcase-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; }
	.showcase-screens { display: flex; gap: 1rem; align-items: flex-end; justify-content: center; }
	.showcase-screens img { border-radius: 2rem; box-shadow: 0 20px 48px rgba(0,0,0,0.4); }
	.showcase-content h2 { font-size: 2.5rem; margin-bottom: 1.5rem; }
	.showcase-content p { color: #9CA3AF; line-height: 1.6; }

	/* Download CTA */
	.download-cta { 
		color: white; 
		text-align: center; 
		padding: 6rem 0;
		position: relative;
		background: transparent;
	}
	.download-cta h2 { font-size: 3rem; margin-bottom: 1rem; color: white; }
	.download-cta p { font-size: 1.25rem; margin-bottom: 2.5rem; opacity: 0.9; }

	.hero-image { display: flex; gap: 1rem; align-items: flex-end; }
	.hero-image img {
		box-shadow: 0 24px 64px rgba(0,0,0,0.5);
		border-radius: 2rem;
	}

	@media (max-width: 768px) {
		.hero-inner, .showcase-inner { grid-template-columns: 1fr; text-align: center; }
		.hero-image, .showcase-screens { justify-content: center; }
		.hero h1 { font-size: 3rem; }
		.showcase.dark { padding: 4rem 0; }
	}
</style>
