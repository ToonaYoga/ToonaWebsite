---
import MainLayout from '../../../layouts/MainLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import supportDataZh from '../../../content/pages/support_zh.json';

const { hero, faq, contact, links } = supportDataZh;
---

<MainLayout title="技术支持与常见问题 — 吐纳: 呼吸练习指南">
	<Nav lang="zh" />
	
	<div style="position: fixed; inset: 0; background-color: #1A1A1A; background-image: radial-gradient(ellipse at 50% 50%, rgba(123, 79, 166, 0.45) 0%, transparent 80%); z-index: -1;"></div>
	<main style="color: white; position: relative;">
		<!-- Page Hero -->
		<section class="page-hero">
			<div class="hero-glow"></div>
			<div class="container hero-content">
				<span class="hero-tag">{hero.tag}</span>
				<h1 set:html={hero.title.replace('\n', '<br>')}></h1>
				<p>{hero.subtitle}</p>
			</div>
		</section>

		<!-- FAQ -->
		<section class="faq section">
			<div class="container">
				<div class="section-header">
					<h2>{faq.title}</h2>
				</div>
				<div class="faq-list">
					{faq.items.map((item) => (
						<div class="faq-item">
							<button class="faq-question">{item.question}</button>
							<div class="faq-answer">{item.answer}</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section class="contact section">
			<div class="container contact-inner">
				<div class="contact-content">
					<h2>{contact.title}</h2>
					{contact.descriptions.map((desc) => (
						<p>{desc}</p>
					))}
				</div>
				<div class="contact-card">
					<div class="icon">{contact.card.icon}</div>
					<h3>{contact.card.title}</h3>
					<p>{contact.card.description}</p>
					<a href={`mailto:${contact.card.email}`} class="contact-email">{contact.card.email}</a>
					<p class="response-time">{contact.card.response}</p>
				</div>
			</div>
		</section>

		<!-- Quick Links -->
		<section class="quick-links section">
			<div class="container">
				<div class="section-header">
					<h2>{links.title}</h2>
				</div>
				<div class="quick-links-grid">
					{links.items.map((link) => (
						<a href={link.href} class="quick-link-card">
							<span class="icon">{link.icon}</span> {link.label}
						</a>
					))}
				</div>
			</div>
		</section>
	</main>

	<Footer lang="zh" />
</MainLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.faq-question').forEach(btn => {
			btn.addEventListener('click', () => {
				const item = btn.parentElement;
				const isOpen = item.classList.contains('open');
				document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
				if (!isOpen) item.classList.add('open');
			});
		});
	});
</script>

<style>
	:global(body) { background-color: #1A1A1A !important; }
	.container { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }
	.section { padding: 80px 0; }
	.section-header { text-align: center; margin-bottom: 3rem; }
	.section-header h2 { font-size: 2.5rem; color: white; }

	/* Hero */
	.page-hero {
		background: transparent;
		color: white;
		padding: 10rem 0 6rem;
		text-align: center;
		position: relative;
	}
	.hero-glow { display: none; }
	.hero-content { position: relative; z-index: 1; max-width: 680px; }
	.hero-tag {
		display: inline-block;
		background: transparent;
		color: #4ECDC4;
		font-size: 0.875rem;
		font-weight: 600;
		padding: 4px 12px;
		border-radius: 999px;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(78, 205, 196, 0.4);
	}
	.page-hero h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.3; margin-bottom: 1.5rem; }
	.page-hero p { color: #9CA3AF; font-size: 1.125rem; line-height: 1.8; }

	/* FAQ */
	.faq { background: transparent; }
	.faq-list { max-width: 800px; margin: 0 auto; }
	.faq-item { background: rgba(255,255,255,0.05); border-radius: 16px; margin-bottom: 1rem; border: 1px solid rgba(255,255,255,0.08); overflow: hidden; }
	.faq-question {
		width: 100%;
		text-align: left;
		padding: 1.5rem 2rem;
		background: transparent;
		border: none;
		font-size: 1.125rem;
		font-weight: 600;
		color: white;
		cursor: pointer;
		position: relative;
	}
	.faq-question::after {
		content: '+';
		position: absolute;
		right: 2rem;
		font-size: 1.5rem;
		color: #9CA3AF;
		transition: transform 0.3s ease;
	}
	.faq-item.open .faq-question::after { transform: rotate(45deg); color: #7B4FA6; }
	.faq-answer {
		padding: 0 2rem;
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.3s ease, padding 0.3s ease;
		color: #9CA3AF;
		line-height: 1.6;
	}
	.faq-item.open .faq-answer { max-height: 500px; padding-bottom: 1.5rem; }

	/* Contact */
	.contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; max-width: 900px; }
	.contact-content h2 { font-size: 2.5rem; color: white; margin-bottom: 1.5rem; }
	.contact-content p { color: #9CA3AF; line-height: 1.6; margin-bottom: 1rem; font-size: 1.125rem; }
	.contact-card {
		background: rgba(255,255,255,0.05);
		padding: 2.5rem;
		border-radius: 24px;
		text-align: center;
		border: 1px solid rgba(255,255,255,0.08);
	}
	.contact-card .icon { font-size: 3rem; margin-bottom: 1rem; }
	.contact-card h3 { font-size: 1.5rem; color: white; margin-bottom: 0.5rem; }
	.contact-card p { color: #9CA3AF; margin-bottom: 1.5rem; }
	.contact-email {
		display: inline-block;
		background: rgba(123, 79, 166, 0.1);
		color: #7B4FA6;
		padding: 12px 24px;
		border-radius: 100px;
		font-weight: 600;
		text-decoration: none;
		margin-bottom: 1rem;
		transition: background 0.3s ease;
	}
	.contact-email:hover { background: rgba(123, 79, 166, 0.2); }
	.response-time { font-size: 0.875rem !important; color: #9CA3AF !important; margin-bottom: 0 !important; }

	/* Quick Links */
	.quick-links { background: transparent; }
	.quick-links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}
	.quick-link-card {
		background: rgba(255,255,255,0.05);
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid rgba(255,255,255,0.08);
		color: #9CA3AF;
		font-weight: 500;
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 1rem;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.quick-link-card:hover { transform: translateY(-3px); background: rgba(255,255,255,0.08); color: #C084FC; }
	.quick-link-card .icon { font-size: 1.5rem; }

	@media (max-width: 768px) {
		.contact-inner { grid-template-columns: 1fr; }
	}
</style>
