---
import MainLayout from '../../../layouts/MainLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import aboutDataZh from '../../../content/pages/about_zh.json';

const { hero, mission, values, story, cta } = aboutDataZh;
---

<MainLayout title="关于 吐纳: 为专注而生的呼吸工具">
	<Nav lang="zh" />
	
	<div style="position: fixed; inset: 0; background-color: #1A1A1A; background-image: radial-gradient(ellipse at 50% 50%, rgba(123, 79, 166, 0.45) 0%, transparent 80%); z-index: -1;"></div>
	<main style="color: white; position: relative;">
		<!-- Page Hero -->
		<section class="page-hero">
			<div class="container page-hero-inner" style="position: relative; z-index: 1;">
				<span class="hero-tag">{hero.tag}</span>
				<h1 set:html={hero.title.replace('\n', '<br>')}></h1>
				<p>{hero.subtitle}</p>
			</div>
		</section>

		<!-- Mission -->
		<section class="mission section">
			<div class="container mission-inner">
				<div class="mission-content">
					<span class="hero-tag mission-tag">{mission.tag}</span>
					<h2 set:html={mission.title.replace('\n', '<br>')}></h2>
					{mission.descriptions.map(p => <p>{p}</p>)}
				</div>
				<div class="mission-visual">
					{mission.stats.map(stat => (
						<div class="mission-stat">
							<h3>{stat.value}</h3>
							<p>{stat.label}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Values -->
		<section class="values section" style="position: relative; overflow: hidden;">
			<div class="hero-glow" style="position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 60%, rgba(123, 79, 166, 0.4) 0%, transparent 65%); pointer-events: none;"></div>
			<div class="container" style="position: relative; z-index: 1;">
				<div class="section-header">
					<h2>{values.title}</h2>
					<p>{values.subtitle}</p>
				</div>
				<div class="values-grid">
					{values.items.map(item => (
						<div class="value-card">
							<div class="icon">{item.icon}</div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Story -->
		<section class="story section">
			<div class="container story-inner">
				<span class="hero-tag story-tag">{story.tag}</span>
				<h2>{story.title}</h2>
				{story.paragraphs.map(p => <p>{p}</p>)}
			</div>
		</section>

		<!-- CTA -->
		<section class="about-cta">
			<div class="container">
				<h2>{cta.title}</h2>
				<p>{cta.description}</p>
				<div class="cta-actions">
					<a href="https://apps.apple.com/us/app/toona-breathing-focus/id6761040533" class="btn btn-download">
						<svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 1v11M4 8l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="2" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
						{cta.button}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer lang="zh" />
</MainLayout>

<style>
	:global(body) { background-color: #1A1A1A !important; }

    /* 样式完全对齐英文版 */
	.section { padding: 80px 0; }
	.container { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }
	
	.hero-tag {
		display: inline-block;
		padding: 6px 16px;
		background: rgba(123, 79, 166, 0.08);
		color: #7B4FA6;
		border-radius: 100px;
		font-size: 0.875rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
	}

	/* Dark Hero - Match Home Page */
	.page-hero {
		padding-top: 10rem;
		padding-bottom: 6rem;
		background: transparent;
		color: white;
		text-align: center;
		position: relative;
	}
	.hero-glow { display: none; }
	.page-hero h1 {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		line-height: 1.3;
		color: white;
		margin-bottom: 2rem;
	}
	.page-hero p {
		max-width: 700px;
		margin: 0 auto;
		font-size: 1.25rem;
		color: #9CA3AF;
		line-height: 1.8;
	}
	.page-hero .hero-tag {
		background: rgba(123, 79, 166, 0.2);
		color: #4ECDC4;
		border: 1px solid rgba(78, 205, 196, 0.2);
	}

	.mission-inner {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 5rem;
		align-items: center;
	}
	.mission-content h2 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
		color: white;
	}
	.mission-content p {
		font-size: 1.125rem;
		color: #9CA3AF;
		line-height: 1.8;
		margin-bottom: 1.5rem;
	}
	.mission-stat {
		background: rgba(255,255,255,0.05);
		padding: 2rem;
		border-radius: 24px;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(255,255,255,0.08);
	}
	.mission-stat h3 { font-size: 2.5rem; color: #C084FC; margin-bottom: 0.5rem; }
	.mission-stat p { font-size: 0.875rem; color: #9CA3AF; font-weight: 500; }

	.values { background: transparent; color: white; padding: 100px 0; }
	.section-header { text-align: center; margin-bottom: 4rem; }
	.section-header h2 { font-size: 2.5rem; color: white; margin-bottom: 1rem; }
	.section-header p { color: #9CA3AF; margin-bottom: 3rem; }
	.values-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}
	.value-card {
		background: rgba(255, 255, 255, 0.03);
		padding: 3.5rem 2rem;
		border-radius: 32px;
		text-align: center;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: transform 0.3s ease, background 0.3s ease;
	}
	.value-card:hover { 
		transform: translateY(-5px);
		background: rgba(255, 255, 255, 0.06);
	}
	.value-card .icon { font-size: 3rem; margin-bottom: 1.5rem; }
	.value-card h3 { font-size: 1.5rem; color: white; margin-bottom: 1rem; }
	.value-card p { color: #9CA3AF; line-height: 1.6; }

	.story-inner { max-width: 800px; }
	.story h2 { font-size: 2.5rem; margin-bottom: 2rem; color: white; }
	.story p { font-size: 1.125rem; color: #9CA3AF; line-height: 1.8; margin-bottom: 1.5rem; }

	.about-cta {
		background: transparent;
		padding: 100px 0;
		color: white;
		text-align: center;
	}
	.about-cta h2 { font-size: 2.5rem; margin-bottom: 1.5rem; }
	.about-cta p { font-size: 1.25rem; opacity: 0.9; margin-bottom: 3rem; }
	.cta-actions { display: flex; justify-content: center; }
	.btn-download {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background: white;
		color: #7B4FA6;
		padding: 16px 36px;
		border-radius: 100px;
		font-weight: 700;
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.mission-inner { grid-template-columns: 1fr; gap: 3rem; }
		.values-grid { grid-template-columns: 1fr; }
		.page-hero { padding-top: 8rem; }
	}
</style>
