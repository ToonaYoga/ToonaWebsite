---
import footer from '../data/footer.json';

const { lang = 'en' } = Astro.props;
const isZH = lang === 'zh';

const brandTitle = isZH ? footer.brand.title_zh : footer.brand.title_en;
const brandDesc = isZH ? footer.brand.description_zh : footer.brand.description_en;
const copyright = isZH ? footer.copyright_owner_zh || footer.copyright_owner : footer.copyright_owner;
---

<footer class="footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<div class="footer-logo">
				<img src="/assets/images/icons/logo.webp" alt="Toona logo" width="32" height="32" style="border-radius:8px;">
				{brandTitle}
			</div>
			<p>{brandDesc}</p>
		</div>
		
		<div class="footer-grid">
			{footer.sections.map(section => (
				<div class="footer-col">
					<h4>{isZH ? section.title_zh : section.title_en}</h4>
					{section.links.map(link => (
						<a href={isZH ? link.url_zh : link.url_en}>
							{isZH ? link.label_zh : link.label_en}
						</a>
					))}
				</div>
			))}
		</div>
	</div>
	<div class="container footer-bottom">
		<p>&copy; {new Date().getFullYear()} {copyright}. All rights reserved.</p>
	</div>
</footer>

<style>
	.footer {
		background: #1A1A1A;
		color: #9CA3AF;
		padding: 4rem 0 2rem;
		border-top: 1px solid #333;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 4rem;
		margin-bottom: 3rem;
	}
	.footer-logo {
		display: flex !important;
		align-items: center !important;
		gap: 0.75rem !important;
		color: #7B4FA6 !important;
		font-weight: 700 !important;
		font-size: 1.125rem !important;
		margin-bottom: 1.5rem !important;
	}


	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}
	.footer-col h4 { color: white; margin-bottom: 1.5rem; }
	.footer-col a { display: block; margin-bottom: 0.75rem; font-size: 0.875rem; }
	.footer-col a:hover { color: white; }
	
	.footer-bottom {
		padding-top: 2rem;
		border-top: 1px solid #333;
		font-size: 0.75rem;
		text-align: center;
	}

	@media (max-width: 768px) {
		.footer-inner { grid-template-columns: 1fr; }
	}
</style>
